# SentinelProxy Environment Configuration Example
# Copy this file to .env and set actual secret values for local development or testing.

# Server binding
SENTINELPROXY_SERVER_ADDR=127.0.0.1:8080

# JWT Authentication
# Shared secret for HS256 JWT signature verification
SENTINELPROXY_JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long_placeholder

# Observability
SENTINELPROXY_LOG_LEVEL=info
SENTINELPROXY_OTLP_ENDPOINT=
